---
import { copy } from '../data/copy';
import { href, labels, name, origin, pages, type Language, type Page } from '../data/site';
import '../styles/site.css';
interface Props { lang: Language; page?: Page; title: string; description?: string; scripts?: boolean; }
const { lang, page, title, description, scripts = true } = Astro.props;
const other = lang === 'en' ? 'es' : 'en';
const t = copy[lang];
const counterpart = page ? href(page, other) : href('home', other);
const own = page ? href(page, lang) : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f1f5f9" />
    {description && <meta name="description" content={description} />}
    <title>{title} · {name}</title>
    {own && <link rel="canonical" href={origin + own} />}
    {own && <link rel="alternate" hreflang={lang} href={origin + own} />}
    <link rel="alternate" hreflang={other} href={origin + counterpart} />
    {page === 'home' && <link rel="alternate" hreflang="x-default" href={origin + href('home', 'en')} />}
    <link rel="stylesheet" href="/tokens.css" />
    {scripts && <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('portfolio.theme'); } catch {}
        const dark = saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelector('meta[name="theme-color"]').content = dark ? '#071421' : '#f1f5f9';
      })();
    </script>}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="masthead">
      <a class="signature" href={href('home', lang)}>{name}<span>{t.brand}</span></a>
      <div class="preferences">
        <a class="tap" href={counterpart} lang={other} hreflang={other} aria-label={t.language}>{other === 'es' ? 'Español' : 'English'}</a>
        {scripts && <button id="theme" hidden aria-pressed="false">{t.theme}</button>}
      </div>
    </header>
    <nav aria-label={t.nav}>
      {pages.map((item) => <a href={href(item, lang)} aria-current={page === item ? 'page' : undefined}>{labels[lang][item]}</a>)}
    </nav>
    <main id="main" tabindex="-1"><slot /></main>
    <footer><span>{name}</span><a class="tap" href={href('links', lang)}>{t.footerLinks} →</a></footer>
    {scripts && <script is:inline>
      (() => {
        const button = document.getElementById('theme');
        const system = matchMedia('(prefers-color-scheme: dark)');
        let explicit = false;
        try { explicit = ['light', 'dark'].includes(localStorage.getItem('portfolio.theme')); } catch {}
        const apply = (dark) => {
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          document.querySelector('meta[name="theme-color"]').content = dark ? '#071421' : '#f1f5f9';
          button.setAttribute('aria-pressed', String(dark));
        };
        apply(document.documentElement.dataset.theme === 'dark');
        button.hidden = false;
        button.addEventListener('click', () => {
          const dark = document.documentElement.dataset.theme !== 'dark';
          explicit = true;
          apply(dark);
          try { localStorage.setItem('portfolio.theme', dark ? 'dark' : 'light'); } catch {}
        });
        system.addEventListener('change', (event) => { if (!explicit) apply(event.matches); });
      })();
    </script>}
  </body>
</html>
