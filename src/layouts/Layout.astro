---
import { copy } from '../data/copy';
import { href, labels, name, origin, pages, type Language, type Page } from '../data/site';
import '../styles/site.css';
interface Props { lang: Language; page?: Page; title: string; description?: string; }
const { lang, page, title, description } = Astro.props;
const other = lang === 'en' ? 'es' : 'en';
const t = copy[lang];
const counterpart = page ? href(page, other) : href('home', other);
const own = page ? href(page, lang) : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f1f5f9" />
    {description && <meta name="description" content={description} />}
    <title>{title} · {name}</title>
    {own && <link rel="canonical" href={origin + own} />}
    {own && <link rel="alternate" hreflang={lang} href={origin + own} />}
    <link rel="alternate" hreflang={other} href={origin + counterpart} />
    {page === 'home' && <link rel="alternate" hreflang="x-default" href={origin + href('home', 'en')} />}
    {['spectral-latin-400', 'archivo-narrow-latin-400', 'archivo-narrow-latin-700'].map((font) => (
      <link rel="preload" as="font" type="font/woff2" href={`/fonts/${font}.woff2`} crossorigin />
    ))}
    <link rel="stylesheet" href="/tokens.css" />
    <script is:inline>
      (()=>{const d=document.documentElement,m=matchMedia('(prefers-color-scheme: dark)'),q=(x)=>document.querySelector(x);let s;try{s=localStorage.getItem('portfolio.theme')}catch{}
      const a=(k)=>{d.dataset.theme=k?'dark':'light';q('meta[name=theme-color]').content=k?'#071421':'#f1f5f9';const b=q('#theme');b&&b.setAttribute('aria-pressed',k)};
      a(s=='dark'||s!='light'&&m.matches);d.dataset.js='';
      addEventListener('DOMContentLoaded',()=>a(d.dataset.theme=='dark'));
      addEventListener('click',(e)=>{if(e.target.closest('#theme')){const k=d.dataset.theme!='dark';s=k?'dark':'light';a(k);try{localStorage.setItem('portfolio.theme',s)}catch{}}});
      m.onchange=(e)=>{s||a(e.matches)}})()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="masthead">
      <a class="signature" href={href('home', lang)}>{name}<span>{t.brand}</span></a>
      <div class="preferences">
        <a class="tap" href={counterpart} lang={other} hreflang={other} aria-label={t.language}>{other === 'es' ? 'Español' : 'English'}</a>
        <button id="theme" aria-pressed="false">{t.theme}</button>
      </div>
    </header>
    <nav aria-label={t.nav}>
      {pages.map((item) => <a href={href(item, lang)} aria-current={page === item ? 'page' : undefined}>{labels[lang][item]}</a>)}
    </nav>
    <main id="main" tabindex="-1"><slot /></main>
    <footer><span>{name}</span><a class="tap" href={href('links', lang)}>{t.footerLinks} →</a></footer>
  </body>
</html>
