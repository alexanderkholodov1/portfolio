      import { startMotion } from '../scripts/motion';
      import { startDemos } from '../scripts/demos';
      import { startRibbon } from '../scripts/ribbon';
      startMotion(); startDemos();
      const builder = document.querySelector<HTMLElement>('[data-builder]');
      if (builder) startRibbon(builder);
