---
import Layout from '../layouts/Layout.astro';
import LiveBanner from './LiveBanner.astro';
import Mark from './Mark.astro';
import { copy } from '../data/copy';
import { certifications, isPending, links, profile, projects, services, socials } from '../data/content';
import { galaxy, galaxyHref, href, labels, projectHref, resolveHref, type Language, type Page } from '../data/site';
interface Props { lang: Language; page: Page; projectId?: string; }
const { lang, page, projectId } = Astro.props;
const current = projectId ? projects.items.find((p) => p.id === projectId) : undefined;
const t = copy[lang];
const role = isPending(profile.role) ? null : profile.role[lang];
const bio = isPending(profile.bio) ? null : profile.bio[lang].split(/\n{2,}/);
const cv = isPending(profile.cv) ? null : profile.cv;
const pad = (n: number) => String(n).padStart(2, '0');
const record = [
  [lang === 'es' ? 'Evento' : 'Event', `${t.banner.event} · USFQ`],
  [lang === 'es' ? 'Rol' : 'Role', isPending(galaxy.role) ? null : galaxy.role[lang]],
  [lang === 'es' ? 'Tecnología' : 'Stack', isPending(galaxy.stack) ? null : galaxy.stack.join(', ')],
  [lang === 'es' ? 'Fechas' : 'Dates', isPending(galaxy.dates) ? null : galaxy.dates[lang]],
].filter((row): row is [string, string] => row[1] !== null);
const image = isPending(galaxy.image) ? null : galaxy.image;
const title = page === 'home' ? t.home.title : page === 'galaxy' ? galaxy.title[lang] : current ? current.title[lang] : labels[lang][page];
// Every project has its own page on this site (his note of 2026-11-17: the overview first, depth one click away).
const entryHref = (project: (typeof projects.items)[number]) => projectHref(project.id, lang);
const description = page === 'home' ? t.home.description : current ? current.pitch[lang] : t[page === 'galaxy' ? 'galaxy' : page === 'project' ? 'projects' : page].description;
// Home: projects grouped by field (his note of 2026-10-26: not one list) and real results.
const byId = (id: string) => projects.items.find((p) => p.id === id);
const fields = [
  { name: t.build.games, ids: ['galaxy', 'farpoint-horizon', 'unallocated', 'sublime-airlift', 'dragons-never-die'] },
  { name: t.build.science, ids: ['munhub-lab', 'dragon-ocean-analyzer', 'zkvote'] },
  { name: t.build.web, ids: ['studium', 'pancho-bus', 'nivela', 'vetweb', 'aklabs-store'] },
  { name: t.build.work, ids: ['tcs-ai', 'usfq-ai-support', 'agent-workshops'] },
].map((f) => ({ ...f, items: f.ids.map(byId).filter((p): p is NonNullable<typeof p> => Boolean(p)) }));
const fieldOf = (id: string) => fields.find((f) => f.ids.includes(id))?.name ?? t.projects.other;
const fieldIndex = (id: string) => { const k = fields.findIndex((f) => f.ids.includes(id)); return k < 0 ? 'o' : String(k); };
// The panorama: the whole range at first sight; each tile opens the project's own page.
const panorama = ['farpoint-horizon', 'galaxy', 'munhub-lab', 'pancho-bus', 'studium', 'nivela', 'unallocated', 'dragon-ocean-analyzer', 'sublime-airlift', 'vetweb', 'zkvote', 'tcs-ai'].map(byId).filter((p): p is NonNullable<typeof p> => Boolean(p));
// Six columns, three rows: two large tiles and ten small ones fill the grid exactly.
const tileSize = (k: number) => (k < 2 ? 'big' : '');
const related = current ? projects.items.filter((p) => p.id !== current.id && fieldIndex(p.id) === fieldIndex(current.id)).slice(0, 3) : [];
const results = [
  { figure: 3, suffix: lang === 'es' ? 'º' : 'rd', project: byId('sublime-airlift') },
  { figure: 4, suffix: lang === 'es' ? 'º' : 'th', project: byId('dragons-never-die') },
  { figure: 5, suffix: lang === 'es' ? 'º' : 'th', project: byId('zkvote') },
].filter((r) => r.project);
const linkedin = socials.items.find((s) => s.id === 'linkedin');
const github = socials.items.find((s) => s.id === 'github');
// Events he took part in, by the names in his projects and his bio (content.ts).
const eventNames = ['NASA Space Apps Challenge 2026', 'Be a Dragon 2026', 'IEEEXtreme 20.0', 'Mini IEEEXtreme 2.0', 'Google DevFest 2026', 'IGNITE Summit 2026', 'Interact2Hack 2026', 'SALA 2026', 'Space Expo', 'Build With AI', 'AWS Gen AI Day', 'Cursor Workshop Quito', 'Cursor x Supabase', 'TCS CodeVita 13', 'IEEEXtreme 19.0', 'DevFest Quito 2025', 'Diners Club Blue Challenge', 'ZKForge Hackathon 2025', 'USFQ IEEE CS Game Jam 2025'];
const cases = t.solve.cases.map(([id, problem]) => ({ problem, project: byId(id)! })).filter((c) => c.project);
const repos = projects.items.filter((p) => p.source?.href.startsWith('https://github.com/')).map((p) => ({ title: p.title[lang], href: p.source!.href, path: p.source!.href.replace('https://github.com/', '') }));
const icons: Record<string, string> = {
  software: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13 6l-2 12"/>', web: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 9h18"/>',
  design: '<path d="M12 3l2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5z"/>', video: '<rect x="3" y="6" width="13" height="12" rx="3"/><path d="M16 10l5-3v10l-5-3"/>',
  '3d': '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>', learn: '<path d="M3 9l9-5 9 5-9 5z"/><path d="M7 11v5c3 2 7 2 10 0v-5"/>',
  other: '<circle cx="12" cy="12" r="8"/><path d="M12 8v8M8 12h8"/>',
};
const s2 = t.services;
// Issuer marks for the certifications (Microsoft; GitHub for GH-900).
const MS_LOGO = `<svg class="ms" viewBox="0 0 23 23" aria-hidden="true"><path fill="#f25022" d="M1 1h10v10H1z"/><path fill="#7fba00" d="M12 1h10v10H12z"/><path fill="#00a4ef" d="M1 12h10v10H1z"/><path fill="#ffb900" d="M12 12h10v10H12z"/></svg>`;
const GH_LOGO = `<svg class="gh" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>`;
// One simple way in: the button opens account creation and the questionnaire.
const startHref = href('start', lang);
---
<Layout lang={lang} page={page} title={title} description={description}>
  {page === 'home' && <>
    <section class="hero" aria-labelledby="name" data-hero>
      <canvas aria-hidden="true"></canvas>
      <h1><span class="name" id="name"><span class="sr">Alexander Kholodov</span><span class="l1" aria-hidden="true">{[...'Alexander'].map((c, i) => <span class="ch" style={`--c:${i}`}>{c}</span>)}</span> <em aria-hidden="true">{[...'Kholodov'].map((c, i) => <span class="ch" style={`--c:${i + 9}`}>{c}</span>)}</em></span></h1>
      <p class="iam">{t.intro.iam}</p>
      <p class="also">{t.intro.also}</p>
      <a class="cue" href="#work"><span>{t.intro.cue}</span><i aria-hidden="true"></i></a>
    </section>

    <section class="band panorama" id="work" aria-labelledby="work-title">
      <p class="kicker" data-reveal>{t.intro.work}</p>
      <h2 id="work-title" data-reveal>{t.panorama.title[0]}<em>{t.panorama.title[1]}</em></h2>
      <p class="lede" data-reveal>{t.panorama.lead}</p>
      <ul class="mosaic">
        {panorama.map((p, k) => (
          <li class={'tile ' + tileSize(k)} data-reveal style={`--i:${k % 4}`}>
            <a href={entryHref(p)} data-glow>
              <span class={'cover f' + fieldIndex(p.id)}>
                {!isPending(p.image) ? <img src={p.image.src} alt="" width="640" height="400" loading={k < 4 ? 'eager' : 'lazy'} decoding="async" /> : <span class="glyph" aria-hidden="true">{p.title[lang].slice(0, 1)}</span>}
              </span>
              <span class="tile-text">
                <small>{fieldOf(p.id)}</small>
                <b>{p.title[lang]}</b>
                <span class="ctx">{p.context[lang]}</span>
                <span class="go">{t.panorama.open} <i aria-hidden="true">→</i></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <p class="all-work" data-reveal><a class="btn-b" href={href('projects', lang)}>{t.stage.all}</a></p>

    <section class="band view bleed tint" aria-labelledby="view-title">
      <h2 class="kicker" id="view-title" data-reveal>{t.view.kicker}</h2>
      <div class="view-grid">
        <figure class="vcard" data-reveal style="--i:0">
          <div class="art fields-art" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
          <figcaption>{t.view.items[0][0]}<em>{t.view.items[0][1]}</em></figcaption>
        </figure>
        <figure class="vcard" data-reveal style="--i:1">
          <div class="art polish-art" aria-hidden="true"><span class="bar"></span><span class="img"></span><span class="ln"></span><span class="ln s"></span><span class="btn"></span></div>
          <figcaption>{t.view.items[1][0]}<em>{t.view.items[1][1]}</em></figcaption>
        </figure>
        <figure class="vcard" data-reveal style="--i:2">
          <div class="art use-art" aria-hidden="true"><span class="press">▶</span><span class="ring"></span><span class="plus">+1</span><svg class="cursor" viewBox="0 0 24 24"><path d="M4 2l15 9-7 1.5L8.5 20z"/></svg></div>
          <figcaption>{t.view.items[2][0]}<em>{t.view.items[2][1]}</em></figcaption>
        </figure>
      </div>
    </section>

    <section class="band events bleed ink" aria-labelledby="events-title">
      <p class="kicker" data-reveal>{t.events.kicker}</p>
      <h2 id="events-title" data-reveal>{t.events.title[0]}<em>{t.events.title[1]}</em></h2>
      <p class="lede" data-reveal>{t.events.lead}</p>
      <div class="marquee" aria-label={eventNames.join(', ')}>
        {[0, 1].map((row) => (
          <div class={'track' + (row ? ' back' : '')} aria-hidden="true">
            {[0, 1].map(() => <span class="run">{(row ? [...eventNames].reverse() : eventNames).map((e) => <span class="ev">{e}</span>)}</span>)}
          </div>
        ))}
      </div>
      <div class="events-grid">
        <ul class="roles">{t.events.roles.map((r, k) => <li data-reveal style={`--i:${k}`}>{r}</li>)}</ul>
        <div class="results">
          <h3 class="kicker" data-reveal>{t.events.podium}</h3>
          <ul>{results.map((r, k) => (
            <li data-reveal style={`--i:${k};--n:${r.figure}`}>
              <b><span class="roll" aria-hidden="true"><span>{Array.from({ length: r.figure }, (_, d) => <span>{d + 1}</span>)}</span></span><span class="sr">{r.figure}</span><sup>{r.suffix}</sup></b>
              <span>{r.project!.title[lang]}</span><span class="soft">{r.project!.context[lang].split(' · ')[0]}</span>
            </li>
          ))}</ul>
        </div>
      </div>
    </section>

    <section class="band certs bleed ink deep" aria-labelledby="certs-title">
      <p class="kicker" data-reveal>{t.certs.kicker}</p>
      <h2 id="certs-title" data-reveal>{t.certs.title[0]}<em>{t.certs.title[1]}</em></h2>
      <p class="lede" data-reveal>{t.certs.lead}</p>
      <ul class="cert-row">
        {certifications.map((c, k) => (
          <li class="cert" data-reveal data-glow style={`--i:${k}`}>
            <span class="seal" aria-hidden="true"><i></i><span class="logo"><Fragment set:html={c.code === 'GH-900' ? GH_LOGO : MS_LOGO} /></span></span>
            <b class="code">{c.code}</b>
            <span class="cname">{c.name}</span>
            <small>{c.issuer} · {c.area[lang]}</small>
          </li>
        ))}
      </ul>
    </section>

    <section class="band solve glow-l" aria-labelledby="solve-title">
      <p class="kicker" data-reveal>{t.solve.kicker}</p>
      <h2 id="solve-title" data-reveal>{t.solve.title[0]}<em>{t.solve.title[1]}</em></h2>
      <div class="cases">
        {cases.map((c, k) => (
          <article class="case" data-reveal data-glow style={`--i:${k}`}>
            <div class="problem"><small>{t.solve.problem}</small><p>{c.problem}</p></div>
            <i class="bridge" aria-hidden="true"></i>
            <div class="solution">
              <small>{t.solve.solution}</small>
              <h3><a href={entryHref(c.project) ?? href('projects', lang)}>{c.project.title[lang]} <span aria-hidden="true">↗</span></a></h3>
              <p>{c.project.pitch[lang].split('. ')[0]}.</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="band open bleed warm" aria-labelledby="open-title">
      <div class="open-grid">
        <div>
          <p class="kicker" data-reveal>{t.open.kicker}</p>
          <h2 id="open-title" data-reveal>{t.open.title[0]}<em>{t.open.title[1]}</em></h2>
          <p class="lede" data-reveal>{t.open.lead}</p>
          {github && <p class="calls" data-reveal><a class="btn-a" href={github.href}>{t.open.profile}<span class="arrow" aria-hidden="true">↗</span></a></p>}
        </div>
        <div class="terminal" data-reveal>
          <p class="bar" aria-hidden="true"><i></i><i></i><i></i></p>
          <ul>{repos.map((r, k) => <li style={`--i:${k}`}><span class="prompt" aria-hidden="true">$</span> git clone <a href={r.href}>{r.path}</a><small>{r.title}</small></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="band invite glow-l" aria-labelledby="invite-title">
      <p class="kicker" data-reveal>{t.invite.kicker}</p>
      <h2 id="invite-title" data-reveal>{t.invite.title[0]}<em>{t.invite.title[1]}</em></h2>
      <p class="lede" data-reveal>{t.invite.lead}</p>
      <ul class="chips-big">{t.invite.items.map((item, k) => <li data-reveal style={`--i:${k}`}>{item}</li>)}</ul>
      {linkedin && <p class="calls" data-reveal><a class="btn-c" href={linkedin.href}><span class="dot" aria-hidden="true"></span>{t.invite.write} · LinkedIn</a></p>}
    </section>

    <section class="band offer bleed ink deep" aria-labelledby="teaser-title">
      <p class="kicker" data-reveal>{t.serviceTeaser.kicker}</p>
      <h2 id="teaser-title" data-reveal>{t.serviceTeaser.title[0]}<em>{t.serviceTeaser.title[1]}</em></h2>
      <p class="lede" data-reveal>{t.serviceTeaser.lead}</p>
      <div class="offer-grid">
        {services.filter((p) => p.id !== 'learn').map((p, k) => (
          <a class="offer-card" data-reveal data-glow style={`--i:${k}`} href={href('services', lang) + '?path=' + p.id}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[p.id]}></svg>
            <b>{p.title[lang]}</b>
            <span>{p.offers.length ? p.offers.map((o) => o.title[lang]).join(' · ') : p.ask[lang]}</span>
            <span class="see">{t.serviceTeaser.see} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
      <p class="calls" data-reveal><a class="btn-a" href={href('services', lang)}>{t.serviceTeaser.cta}<span class="arrow" aria-hidden="true">→</span></a></p>
    </section>

    <section class="band contact glow-r" aria-labelledby="contact-title">
      <h2 id="contact-title" data-reveal>{t.contact.title[0]}<em>{t.contact.title[1]}</em></h2>
      <p class="lede" data-reveal>{t.contact.lead}</p>
      <p class="calls" data-reveal>
        {linkedin && <a class="btn-c" href={linkedin.href}><span class="dot" aria-hidden="true"></span>{t.invite.write} · LinkedIn</a>}
      </p>
    </section>
    <script>
      import { startMotion } from '../scripts/motion';
      import { startRibbon } from '../scripts/ribbon';
      import { startLetters } from '../scripts/letters';
      const hero = document.querySelector<HTMLElement>('[data-hero]');
      if (hero) { startRibbon(hero); startLetters(hero); }
      startMotion();
    </script>
  </>}

  {page === 'services' && <>
    <section class="svc-hero builder" data-builder>
      <canvas class="ribbon-bg" aria-hidden="true"></canvas>
      <div class="b-copy">
        <p class="kicker">{s2.eyebrow}</p>
        <h1>{s2.title[0]}<em>{s2.title[1]}</em></h1>
        <p class="lede">{s2.lead}</p>
        <p class="calls"><a class="btn-a big" href={startHref}>{s2.start}<span class="arrow" aria-hidden="true">→</span></a></p>
        <p class="note">{s2.startNote}</p>
      </div>
      <div class="b-stage">
        {s2.builder.map((b, k) => (
          <div class="b-window mini" data-build={k} style={`--k:${k}`}>
            <p class="b-label">{b.label}</p>
            <p class="b-prompt" aria-hidden="true"><span class="spark">✦</span><span data-typed data-text={b.prompt}></span><i class="caret"></i></p>
            <div class="b-out" aria-hidden="true">
              {k === 0 && <Fragment set:html={`<div class="sc sc-web"><p class="w-nav"><b></b><i></i><i></i><i></i></p><div class="w-hero"><div><span class="w-h"></span><span class="w-h s"></span><span class="w-btn"></span></div><span class="w-img"></span></div><p class="w-cards"><i></i><i></i><i></i></p></div>`} />}
              {k === 1 && <Fragment set:html={`<div class="sc sc-app"><div class="a-phone"><span class="a-toast"></span><span class="a-ttl"></span><i></i><i></i><i></i><span class="a-tab"></span></div></div>`} />}
              {k === 2 && <Fragment set:html={`<div class="sc sc-game"><span class="g-sun"></span><span class="g-hill"></span><span class="g-ground"></span><span class="g-hero"></span><span class="g-block"></span><span class="g-coin"></span><span class="g-coin c2"></span></div>`} />}
              {k === 3 && <Fragment set:html={`<div class="sc sc-3d"><span class="m-floor"></span><div class="m-cube"><i class="f"></i><i class="b"></i><i class="l"></i><i class="r"></i><i class="t"></i><i class="d"></i></div></div>`} />}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="band" aria-labelledby="demos-title">
      <h2 id="demos-title" data-reveal>{s2.gridTitle[0]}<em>{s2.gridTitle[1]}</em></h2>
      <div class="demos">
        <figure data-glow class="demo d-web" data-demo>
          <div class="art" aria-hidden="true">
            <div class="browser">
              <p class="chrome"><i></i><i></i><i></i><span class="url">{s2.web.url}</span></p>
              <div class="site">
                <p class="nav"><b>{s2.web.brand}</b>{s2.web.nav.map((n) => <span>{n}</span>)}</p>
                <div class="hero-row"><div><p class="h">{s2.web.heading}</p><p class="cta">{s2.web.cta}</p></div><span class="photo"></span></div>
                <div class="cards"><span></span><span></span><span></span></div>
              </div>
              <svg class="cursor" viewBox="0 0 24 24"><path d="M4 2l15 9-7 1.5L8.5 20z"/></svg>
            </div>
          </div>
          <figcaption>{s2.demos.web}</figcaption>
        </figure>
        <figure data-glow class="demo d-app" data-demo>
          <div class="art" aria-hidden="true">
            <div class="phone"><div class="scr">
              <p class="toast">{s2.app.toast}</p>
              <p class="ttl">{s2.app.title}</p>
              {s2.app.items.map((it, k) => <p class="row" style={`--k:${k}`}><span>{it}</span><small class={k === 0 ? 'go' : ''}>{s2.app.status[k]}</small></p>)}
              <p class="tabs"><i></i><i></i><i></i></p>
            </div></div>
          </div>
          <figcaption>{s2.demos.app}</figcaption>
        </figure>
        <figure data-glow class="demo d-bots" data-demo>
          <div class="art" aria-hidden="true">
            <div class="col in"><p>{s2.bots.inbox}</p>{[0, 1, 2, 3].map((k) => <i style={`--k:${k}`}></i>)}</div>
            <span class="bot"><b></b></span>
            <div class="col out"><p>{s2.bots.sheet}</p>{[0, 1, 2, 3].map((k) => <span style={`--k:${k}`}><i></i><em>✓</em></span>)}</div>
          </div>
          <figcaption>{s2.demos.bots}</figcaption>
        </figure>
        <figure data-glow class="demo d-ai" data-demo>
          <div class="art" aria-hidden="true">
            <p class="who"><span class="av"></span>{s2.chat.name}<i class="on"></i></p>
            <p class="q">{s2.chat.q}</p>
            <p class="typing"><i></i><i></i><i></i></p>
            <p class="a"><span>{s2.chat.a}</span></p>
          </div>
          <figcaption>{s2.demos.ai}</figcaption>
        </figure>
        <figure data-glow class="demo d-game" data-demo data-game>
          <div class="art">
            <span class="sun" aria-hidden="true"></span><span class="hills" aria-hidden="true"></span><span class="hills b" aria-hidden="true"></span>
            <span class="ground" aria-hidden="true"></span><span class="hero-sq" aria-hidden="true"><i></i></span><span class="block" aria-hidden="true"></span><span class="coin" aria-hidden="true"></span>
            <p class="hud" aria-hidden="true">{s2.score} <b data-score>0</b></p>
            <button type="button" class="try">{s2.tryIt}</button>
          </div>
          <figcaption>{s2.demos.game}</figcaption>
        </figure>
        <figure data-glow class="demo d-design" data-demo data-design>
          <div class="art" aria-hidden="true">
            <p class="tools"><i></i><i></i><i></i><i></i></p>
            <div class="canvas"><div class="poster"><span class="sun"></span><span class="band1"></span><span class="band2"></span><b>Aa</b></div><span class="sel"></span></div>
            <p class="swatches"><i></i><i></i><i></i><i></i></p>
          </div>
          <figcaption>{s2.demos.design}</figcaption>
        </figure>
        <figure data-glow class="demo d-video" data-demo>
          <div class="art" aria-hidden="true">
            <div class="viewer"><span class="scene"><i class="sun"></i><i class="hill"></i></span><p class="rec">REC</p><p class="tc">00:00:<b>12</b></p></div>
            <div class="tracks"><p class="trk v"><span class="c1"></span><span class="c2"></span><span class="c3"></span></p><p class="trk a">{Array.from({ length: 36 }, (_, k) => <i style={`--h:${20 + ((k * 37) % 70)}%`}></i>)}</p><i class="head"></i></div>
          </div>
          <figcaption>{s2.demos.video}</figcaption>
        </figure>
        <figure data-glow class="demo d-model" data-demo data-model>
          <div class="art" aria-hidden="true">
            <span class="floor"></span>
            <div class="cube">{['f', 'b', 'l', 'r', 't', 'd'].map((f) => <span class={'face ' + f}></span>)}</div>
            <p class="gizmo"><i class="x">X</i><i class="y">Y</i><i class="z">Z</i></p>
          </div>
          <figcaption>{s2.demos.model}</figcaption>
        </figure>
      </div>
    </section>

    <section class="band ideas bleed warm" aria-labelledby="ideas-title">
      <h2 id="ideas-title" data-reveal>{s2.ideasTitle[0]}<em>{s2.ideasTitle[1]}</em></h2>
      <div class="marquee" aria-label={s2.ideas.join(', ')}>
        {[0, 1].map((row) => (
          <div class={'track' + (row ? ' back' : '')} aria-hidden="true">
            {[0, 1].map(() => <span class="run">{(row ? [...s2.ideas].reverse() : s2.ideas).map((e) => <span class="ev">{e}</span>)}</span>)}
          </div>
        ))}
      </div>
    </section>

    <section class="band svc-end bleed ink deep" aria-labelledby="end-title">
      <h2 id="end-title" data-reveal>{s2.endTitle[0]}<em>{s2.endTitle[1]}</em></h2>
      <p class="lede" data-reveal>{s2.endLead}</p>
      <p class="calls" data-reveal><a class="btn-a big" href={startHref}>{s2.start}<span class="arrow" aria-hidden="true">→</span></a></p>
    </section>
    <script>
      import { startMotion } from '../scripts/motion';
      import { startDemos } from '../scripts/demos';
      import { startRibbon } from '../scripts/ribbon';
      startMotion(); startDemos();
      const builder = document.querySelector<HTMLElement>('[data-builder]');
      if (builder) startRibbon(builder);
    </script>
  </>}

  {page === 'projects' && <>
    <section class="page-hero">
      <p class="kicker">{t.projects.eyebrow}</p>
      <h1>{t.projects.title[0]}<em>{t.projects.title[1]}</em></h1>
      <div class="filters" role="group" aria-label={t.projects.eyebrow} data-filters hidden>
        {[['all', t.projects.all], ...fields.map((f, k) => [String(k), f.name]), ['other', t.projects.other]].map(([id, label], k) => <button type="button" data-filter={id} aria-pressed={k === 0 ? 'true' : 'false'}>{label}</button>)}
      </div>
    </section>
    <ol class="pgrid" data-grid>
      {projects.items.map((project, index) => {
        const field = fields.findIndex((f) => f.ids.includes(project.id));
        const go = entryHref(project);
        return (
          <li class="pcard" data-field={field < 0 ? 'other' : String(field)} data-reveal data-glow style={`--i:${index % 3}`}>
            <div class={'cover f' + (field < 0 ? 'o' : field)}>
              {!isPending(project.image) ? <img src={project.image.src} alt={project.image.alt[lang]} width="640" height="400" loading="lazy" decoding="async" /> : <span class="glyph" aria-hidden="true">{pad(index + 1)}</span>}
            </div>
            <div class="pbody">
              <p class="kicker">{project.context[lang]}{!isPending(project.dates) && ' · ' + project.dates[lang]}</p>
              <h2>{go ? <a href={go}>{project.title[lang]}</a> : project.title[lang]}</h2>
              <p class="pitch">{project.pitch[lang]}</p>
              {!isPending(project.stack) && project.stack.length > 0 && <ul class="stack-chips">{project.stack.map((s) => <li>{s}</li>)}</ul>}
              {(project.href || project.source) && (
                <p class="actions">
                  {project.href && <a class="tap" href={resolveHref(project.href, lang)}>{t.projects.open} <Mark external={project.id !== galaxy.id && project.href.startsWith('http')} /></a>}
                  {project.source && <a class="tap" href={project.source.href}>{t.projects.source} <Mark external /></a>}
                </p>
              )}
            </div>
          </li>
        );
      })}
    </ol>
    <script>
      import { startMotion } from '../scripts/motion';
      startMotion();
      const bar = document.querySelector<HTMLElement>('[data-filters]');
      if (bar) {
        bar.hidden = false;
        bar.addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]'); if (!b) return;
          bar.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          document.querySelectorAll<HTMLElement>('[data-grid] > li').forEach((li) => { li.hidden = b.dataset.filter !== 'all' && li.dataset.field !== b.dataset.filter; });
        });
      }
    </script>
  </>}

  {page === 'about' && <>
    <section class="page-hero about-hero">
      <div class="shapes" aria-hidden="true"><i class="s1"></i><i class="s2"></i><i class="s3"></i></div>
      <p class="kicker">{t.about.eyebrow}</p>
      <h1>Alexander <em>Kholodov</em></h1>
      {role && <p class="lede">{role}</p>}
    </section>
    {bio && <section class="band bio" aria-label={t.about.eyebrow}>
      <p class="first" data-reveal>{bio[1]}</p>
      <div class="cols">{bio.slice(2).map((paragraph, k) => <p data-reveal style={`--i:${k % 2}`}>{paragraph}</p>)}</div>
    </section>}
    <section class="band certs bleed ink deep" aria-labelledby="certs-title-about">
      <p class="kicker" data-reveal>{t.certs.kicker}</p>
      <h2 id="certs-title-about" data-reveal>{t.certs.title[0]}<em>{t.certs.title[1]}</em></h2>
      <p class="lede" data-reveal>{t.certs.lead}</p>
      <ul class="cert-row">
        {certifications.map((c, k) => (
          <li class="cert" data-reveal data-glow style={`--i:${k}`}>
            <span class="seal" aria-hidden="true"><i></i><span class="logo"><Fragment set:html={c.code === 'GH-900' ? GH_LOGO : MS_LOGO} /></span></span>
            <b class="code">{c.code}</b>
            <span class="cname">{c.name}</span>
            <small>{c.issuer} · {c.area[lang]}</small>
          </li>
        ))}
      </ul>
    </section>

    <section class="band find bleed tint" aria-labelledby="find-title">
      <h2 id="find-title" data-reveal>{t.about.find}</h2>
      <ul class="socials">
        {cv && <li><a class="soc s-cv" href={cv.href} data-glow><b>{cv.label[lang]}</b><Mark external /></a></li>}
        {socials.items.map((social, k) => <li data-reveal style={`--i:${k}`}><a class={'soc s-' + social.id} href={social.href} data-glow><b>{social.label}</b><span>{social.handle}</span></a></li>)}
      </ul>
      <p class="calls" data-reveal><a class="btn-b" href={href('projects', lang)}>{labels[lang].projects}</a><a class="btn-b" href={href('links', lang)}>{labels[lang].links}</a></p>
    </section>
    <script>
      import { startMotion } from '../scripts/motion';
      startMotion();
    </script>
  </>}

  {page === 'start' && <>
    <section class="start" data-start data-lang={lang} data-copy={JSON.stringify(t.start)}>
      <div class="start-head">
        <p class="kicker">{t.start.eyebrow}</p>
        <h1>{t.start.title[0]}<em>{t.start.title[1]}</em></h1>
        <p class="lede">{t.start.total}</p>
        <ol class="steps">{t.start.steps.map((step, k) => <li data-step={k}><i aria-hidden="true">{k + 1}</i><span>{step}</span></li>)}</ol>
      </div>
      <div class="start-view" data-view aria-live="polite"></div>
    </section>
    <script>
      import { startFlow } from '../scripts/start';
      const root = document.querySelector<HTMLElement>('[data-start]');
      if (root) startFlow(root);
    </script>
  </>}

  {page === 'project' && current && <>
    <section class="project-page">
      <p class="back"><a href={href('projects', lang)}>← {t.project.back}</a></p>
      <div class="pp-grid">
        <div>
          <p class="kicker">{fieldOf(current.id)}</p>
          <h1>{current.title[lang]}</h1>
          <p class="pp-ctx">{current.context[lang]}</p>
          <p class="lede">{current.pitch[lang]}</p>
          <dl class="pp-facts">
            {!isPending(current.role) && <div><dt>{t.project.role}</dt><dd>{current.role[lang]}</dd></div>}
            {!isPending(current.dates) && <div><dt>{t.project.dates}</dt><dd>{current.dates[lang]}</dd></div>}
          </dl>
          {!isPending(current.stack) && current.stack.length > 0 && <ul class="stack-chips" aria-label={t.project.stack}>{current.stack.map((x) => <li>{x}</li>)}</ul>}
          <p class="calls">
            {current.href && <a class="btn-a" href={resolveHref(current.href, lang)}>{fieldIndex(current.id) === '0' ? t.stage.play : t.stage.open}<span class="arrow" aria-hidden="true">↗</span></a>}
            {current.source && current.source.href !== current.href && <a class="btn-b" href={current.source.href}>{t.projects.source}</a>}
          </p>
        </div>
        <div class={'pp-visual cover f' + fieldIndex(current.id)}>
          {!isPending(current.image) ? <img src={current.image.src} alt={current.image.alt[lang]} width="1280" height="800" /> : <span class="glyph" aria-hidden="true">{current.title[lang].slice(0, 1)}</span>}
        </div>
      </div>
    </section>
    {related.length > 0 && <section class="band" aria-labelledby="more-title">
      <h2 id="more-title" class="kicker">{t.project.more}</h2>
      <ul class="mosaic small">
        {related.map((p) => (
          <li class="tile"><a href={entryHref(p)} data-glow>
            <span class={'cover f' + fieldIndex(p.id)}>{!isPending(p.image) ? <img src={p.image.src} alt="" width="640" height="400" loading="lazy" decoding="async" /> : <span class="glyph" aria-hidden="true">{p.title[lang].slice(0, 1)}</span>}</span>
            <span class="tile-text"><small>{fieldOf(p.id)}</small><b>{p.title[lang]}</b><span class="ctx">{p.context[lang]}</span></span>
          </a></li>
        ))}
      </ul>
    </section>}
    <section class="band svc-end bleed ink deep" aria-labelledby="like-title">
      <h2 id="like-title">{t.project.like[0]}<em>{t.project.like[1]}</em></h2>
      <p class="lede">{t.project.likeLead}</p>
      <p class="calls"><a class="btn-a big" href={startHref}>{t.project.start}<span class="arrow" aria-hidden="true">→</span></a></p>
    </section>
    <script>
      import { startMotion } from '../scripts/motion';
      startMotion();
    </script>
  </>}

  {page === 'links' && <>
    <h1>{labels[lang].links}</h1>
    <ul class="ledger callsigns">
      {links.items.map((link) => (
        <li><a class="entry slim" href={resolveHref(link.href, lang)}>
          <span class="title">{link.label[lang]}</span>
          {link.detail && <span class="meta">{link.detail[lang]}</span>}
          <span class="arrow"><Mark external={link.external} /></span>
        </a></li>
      ))}
      {socials.items.map((social) => <li><a class="entry slim" href={social.href}><span class="title">{social.label}</span><span class="meta">{social.handle}</span><span class="arrow"><Mark external /></span></a></li>)}
    </ul>
  </>}

  {page === 'galaxy' && <>
    <section class="band galaxy-page bleed ink">
      <p class="kicker">{t.galaxy.eyebrow}</p>
      <h1>{galaxy.title[lang]}</h1>
      <div class="galaxy-grid">
        <div>
          <p class="lede">{galaxy.pitch[lang]}</p>
          <p class="calls"><a class="btn-a" href={galaxyHref(lang)}>{t.galaxy.open}<span class="arrow" aria-hidden="true">↗</span></a>{galaxy.source && <a class="btn-b" href={galaxy.source.href}>{galaxy.source.label[lang]}</a>}</p>
        </div>
        {image ? <img class="shot-big" src={image.src} alt={image.alt[lang]} width="1280" height="800" /> : <div class="orbit" aria-hidden="true"><i></i><b></b></div>}
      </div>
      <h2 class="label">{t.galaxy.facts}</h2>
      <dl class="record">{record.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl>
    </section>
  </>}
</Layout>
