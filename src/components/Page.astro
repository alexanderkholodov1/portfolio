  </>}

  {page === 'projects' && <>
    <section class="page-hero">
      <p class="kicker">{t.projects.eyebrow}</p>
      <h1>{t.projects.title[0]}<em>{t.projects.title[1]}</em></h1>
      <div class="filters" role="group" aria-label={t.projects.eyebrow} data-filters hidden>
        {[['all', t.projects.all], ...fields.map((f, k) => [String(k), f.name]), ...(projects.items.some((p) => !fields.some((f) => f.ids.includes(p.id))) ? [['other', t.projects.other]] : [])].map(([id, label], k) => <button type="button" data-filter={id} aria-pressed={k === 0 ? 'true' : 'false'}>{label}</button>)}
      </div>
    </section>
    <ol class="pgrid" data-grid>
      {projects.items.map((project, index) => {
        const field = fields.findIndex((f) => f.ids.includes(project.id));
        const go = entryHref(project);
        return (
          <li class="pcard" data-field={field < 0 ? 'other' : String(field)} data-reveal data-glow style={`--i:${index % 3}`}>
            <div class={'cover f' + (field < 0 ? 'o' : field)}>
              {!isPending(project.image) ? <img src={project.image.src} alt={project.image.alt[lang]} width="640" height="400" loading="lazy" decoding="async" /> : <span class="glyph" aria-hidden="true">{project.title[lang].slice(0, 1)}</span>}
            </div>
            <div class="pbody">
              <p class="kicker">{project.context[lang]}{!isPending(project.dates) && ' · ' + project.dates[lang]}</p>
              <h2>{go ? <a href={go}>{project.title[lang]}</a> : project.title[lang]}</h2>
              <p class="pitch">{project.pitch[lang]}</p>
              {!isPending(project.stack) && project.stack.length > 0 && <ul class="stack-chips">{project.stack.map((s) => <li>{s}</li>)}</ul>}
              {(project.href || project.source) && (
                <p class="actions">
                  {project.href && <a class="tap" href={resolveHref(project.href, lang)}>{t.projects.open} <Mark external={project.id !== galaxy.id && project.href.startsWith('http')} /></a>}
                  {project.source && <a class="tap" href={project.source.href}>{t.projects.source} <Mark external /></a>}
                </p>
              )}
            </div>
          </li>
        );
      })}
    </ol>
    <script>
      import { startMotion } from '../scripts/motion';
      startMotion();
      const bar = document.querySelector<HTMLElement>('[data-filters]');
      if (bar) {
        bar.hidden = false;
        bar.addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]'); if (!b) return;
          bar.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          document.querySelectorAll<HTMLElement>('[data-grid] > li').forEach((li) => { li.hidden = b.dataset.filter !== 'all' && li.dataset.field !== b.dataset.filter; });
        });
      }
    </script>
  </>}

  {page === 'about' && <>
    <section class="ab-hero">
      <div class="ab-copy">
        <p class="kicker">{t.about.eyebrow}</p>
        <h1>Alexander <em>Kholodov</em></h1>
        {role && <p class="lede">{role}</p>}
        <ul class="ab-facts">{t.about.facts.map((fact, k) => <li style={`--i:${k}`}>{fact}</li>)}</ul>
      </div>
      <figure class="ab-portrait">
        <span class="ab-frame" data-glow><img src="/about/portrait.webp" alt={t.about.portrait} width="960" height="1200" fetchpriority="high" decoding="async" /></span>
      </figure>
    </section>

    <section class="band ab-motto bleed tint" aria-labelledby="motto-title">
      <div class="ab-motto-in">
        <h2 id="motto-title" data-reveal>{t.about.motto[0]}<em>{t.about.motto[1]}</em>{t.about.motto[2]}</h2>
        <p class="lede" data-reveal style="--i:1">{t.about.mottoLead}</p>
      </div>
    </section>

    <section class="band ab-does" aria-label={t.about.doesLabel}>
      <ul class="ab-grid">
        {([
          ['build', href('projects', lang), null],
          ['compete', href('experience', lang) + '#competition', '/projects/devfest-ctf.webp'],
          ['lead', href('experience', lang) + '#ieee', '/activities/ieee-vp.webp'],
          ['work', href('experience', lang) + '#work', '/about/tcs-welcome.webp'],
          ['video', href('services', lang) + '#demo-video', null],
        ] as const).map(([key, link, photo], k) => {
          const d = t.about.does[key];
          return (
            <li class={'ab-card c-' + key} data-reveal style={`--i:${k % 3}`}>
              <a href={link} data-glow>
                {key === 'build' ? (
                  <span class="ab-art ab-mosaic" aria-hidden="true">{shownOnAbout.map((p) => <img src={`/projects/${p.id}.webp`} alt="" width="640" height="400" loading="lazy" decoding="async" />)}</span>
                ) : key === 'video' ? (
                  <span class="ab-art ab-video" aria-hidden="true">
                    <span class="tc">00:00:12</span>
                    <span class="vt"><i style="--x:3%;--w:34%"></i><i style="--x:39%;--w:22%"></i><i style="--x:63%;--w:33%"></i></span>
                    <span class="vt b"><i style="--x:12%;--w:28%"></i><i style="--x:52%;--w:40%"></i></span>
                    <span class="vt c"><i style="--x:3%;--w:93%"></i></span>
                    <span class="ph"></span>
                  </span>
                ) : (
                  <span class="ab-art"><img src={photo} alt="" width="960" height="600" loading="lazy" decoding="async" /></span>
                )}
                <span class="ab-text"><b>{d.title[0]}<em>{d.title[1]}</em></b><span>{d.text}</span>{key === 'build' && <span class="ab-names">{shownOnAbout.map((p) => <i>{p.title[lang]}</i>)}</span>}<small>{d.go} <span aria-hidden="true">→</span></small></span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="band certs bleed ink deep" aria-labelledby="learn-title">
      <p class="kicker" data-reveal>{t.about.learn.kicker}</p>
      <h2 id="learn-title" data-reveal>{t.about.learn.title[0]}<em>{t.about.learn.title[1]}</em></h2>
      <p class="lede" data-reveal>{t.about.learn.lead}</p>
      <ul class="cert-row">
        {certifications.map((c, k) => (
          <li class="cert" data-reveal data-glow style={`--i:${k}`}>
            <span class="seal" aria-hidden="true"><i></i><span class="logo"><Fragment set:html={c.code === 'GH-900' ? GH_LOGO : MS_LOGO} /></span></span>
            <b class="code">{c.code}</b>
            <span class="cname">{c.name}</span>
            <small>{c.issuer} · {c.area[lang]}</small>
          </li>
        ))}
      </ul>
    </section>

    <section class="band find bleed tint" aria-labelledby="find-title">
      <h2 id="find-title" data-reveal>{t.about.find}</h2>
      <ul class="socials">
        {cv && <li><a class="soc s-cv" href={cv.href} data-glow><b>{cv.label[lang]}</b><Mark external /></a></li>}
        {socials.items.map((social, k) => <li data-reveal style={`--i:${k}`}><a class={'soc s-' + social.id} href={social.href} data-glow><b>{social.label}</b><span>{social.handle}</span></a></li>)}
      </ul>
      <p class="calls" data-reveal><a class="btn-a big" href={startHref}>{t.serviceTeaser.start}<span class="arrow" aria-hidden="true">→</span></a><a class="btn-b" href={href('projects', lang)}>{labels[lang].projects}</a></p>
    </section>
    <script>
      import { startMotion } from '../scripts/motion';
      startMotion();
    </script>
  </>}

  {page === 'start' && <>
    <section class="start" data-start data-lang={lang} data-copy={JSON.stringify(t.start)}>
      <div class="start-head">
        <p class="kicker">{t.start.eyebrow}</p>
        <h1>{t.start.title[0]}<em>{t.start.title[1]}</em></h1>
        <p class="lede">{t.start.total}</p>
        <ol class="steps">{t.start.steps.map((step, k) => <li data-step={k}><i aria-hidden="true">{k + 1}</i><span>{step}</span></li>)}</ol>
      </div>
      <div class="start-view" data-view aria-live="polite"></div>
    </section>
    <script>
      import { startFlow } from '../scripts/start';
      const root = document.querySelector<HTMLElement>('[data-start]');
      if (root) startFlow(root);
    </script>
  </>}

  {page === 'project' && current && <>
    <section class="project-page">
      <p class="back"><a href={href('projects', lang)}>← {t.project.back}</a></p>
      <div class="pp-grid">
        <div>
          <p class="kicker">{fieldOf(current.id)}</p>
          <h1>{current.title[lang]}</h1>
          <p class="pp-ctx">{current.context[lang]}</p>
          <p class="lede">{current.pitch[lang]}</p>
          <dl class="pp-facts">
            {!isPending(current.role) && <div><dt>{t.project.role}</dt><dd>{current.role[lang]}</dd></div>}
            {!isPending(current.dates) && <div><dt>{t.project.dates}</dt><dd>{current.dates[lang]}</dd></div>}
          </dl>
          {!isPending(current.stack) && current.stack.length > 0 && <ul class="stack-chips" aria-label={t.project.stack}>{current.stack.map((x) => <li>{x}</li>)}</ul>}
          <p class="calls">
            {current.href && <a class="btn-a" href={resolveHref(current.href, lang)}>{fieldIndex(current.id) === '0' ? t.stage.play : t.stage.open}<span class="arrow" aria-hidden="true">↗</span></a>}
            {current.source && current.source.href !== current.href && <a class="btn-b" href={current.source.href}>{t.projects.source}</a>}
          </p>
        </div>
        <div class={'pp-visual cover f' + fieldIndex(current.id)}>
          {!isPending(current.image) ? <img src={current.image.src} alt={current.image.alt[lang]} width="1280" height="800" /> : <span class="glyph" aria-hidden="true">{current.title[lang].slice(0, 1)}</span>}
        </div>
      </div>
    </section>
    {related.length > 0 && <section class="band" aria-labelledby="more-title">
      <h2 id="more-title" class="kicker">{t.project.more}</h2>
      <ul class="mosaic small">
        {related.map((p) => (
          <li class="tile"><a href={entryHref(p)} data-glow>
            <span class={'cover f' + fieldIndex(p.id)}>{!isPending(p.image) ? <img src={p.image.src} alt="" width="640" height="400" loading="lazy" decoding="async" /> : <span class="glyph" aria-hidden="true">{p.title[lang].slice(0, 1)}</span>}</span>
            <span class="tile-text"><small>{fieldOf(p.id)}</small><b>{p.title[lang]}</b><span class="ctx">{p.context[lang]}</span></span>
          </a></li>
        ))}
      </ul>
    </section>}
    <section class="band svc-end bleed ink deep" aria-labelledby="like-title">
      <h2 id="like-title">{t.project.like[0]}<em>{t.project.like[1]}</em></h2>
      <p class="lede">{t.project.likeLead}</p>
      <p class="calls"><a class="btn-a big" href={startHref}>{t.project.start}<span class="arrow" aria-hidden="true">→</span></a></p>
    </section>
    <script>
      import { startMotion } from '../scripts/motion';
      startMotion();
    </script>
  </>}

  {page === 'admin' && <>
    <section class="admin" data-admin data-copy={JSON.stringify(t.admin)}>
      <h1 class="admin-title">{t.admin.title}</h1>
      <div data-view aria-live="polite"></div>
    </section>
    <script>
      import { startAdmin } from '../scripts/admin';
      const root = document.querySelector<HTMLElement>('[data-admin]');
      if (root) startAdmin(root);
    </script>
  </>}

  {page === 'experience' && <>
    <section class="xp-hero">
      <p class="kicker">{t.experiencePage.eyebrow}</p>
      <h1>{t.experiencePage.title[0]}<em>{t.experiencePage.title[1]}</em></h1>
      <p class="lede">{t.experiencePage.lead}</p>
    </section>
    <nav class="xp-tabs" aria-label={t.experiencePage.eyebrow} data-exp-tabs>
      <button type="button" data-kind="all" aria-pressed="true">{t.experiencePage.all}</button>
      {groups.map((g) => <button type="button" class={'k-' + g.k} data-kind={g.k} aria-pressed="false"><i aria-hidden="true"></i>{t.experiencePage.kinds[g.k]}</button>)}
    </nav>
    {groups.map((g) => (
      <section class={'band xg k-' + g.k} data-group={g.k} aria-labelledby={'g-' + g.k}>
        <div class="xg-head">
          <h2 id={'g-' + g.k}>{t.experiencePage.kinds[g.k]}</h2>
          <p>{t.experiencePage.leads[g.k]}</p>
        </div>
        <ul class={g.k === 'event' ? 'xg-events' : 'xg-cards'}>
          {g.items.map((a, i) => g.k === 'event' ? (
            <li class="xe" data-reveal style={`--i:${i % 4}`}>
              <img src={a.image} alt="" width="960" height="600" loading="lazy" decoding="async" />
              <span><b>{a.title[lang]}</b><small>{a.date[lang]}</small></span>
            </li>
          ) : (
            <li class={'xc' + (i < (g.items.length === 1 ? 1 : (3 - g.items.length % 3) % 3) ? ' lead' : '') + (g.items.length === 1 ? ' only' : '')} data-reveal data-glow style={`--i:${i % 3}`}>
              <span class="xc-shot"><img src={a.image} alt="" width="960" height="600" loading="lazy" decoding="async" />
                {(a.result || a.solo) && <span class={'xc-flag' + (a.solo ? ' solo' : '')}>{a.result ? a.result[lang] : '★ ' + t.experiencePage.solo}</span>}
              </span>
              <div class="xc-body">
                <p class="xc-meta"><span>{a.date[lang]}</span>{a.org && <span>{a.org[lang]}</span>}{a.role && <span>{a.role[lang]}</span>}</p>
                <h3>{a.title[lang]}</h3>
                {a.text && <p class="xc-text">{a.text[lang]}</p>}
                {(a.page || a.post) && <p class="xp-links">{a.page && <a class="xl" href={projectHref(a.page, lang)}>{t.experiencePage.more} <span aria-hidden="true">→</span></a>}{a.post && <a class="xl li" href={a.post}><span class="in" aria-hidden="true">in</span>{t.experiencePage.linkedin}</a>}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section class="band xp-end bleed ink deep">
      <h2>{t.experiencePage.endTitle[0]}<em>{t.experiencePage.endTitle[1]}</em></h2>
      <p class="calls"><a class="btn-a big" href={linkedinActivity}>{t.experiencePage.feed}<span class="arrow" aria-hidden="true">↗</span></a></p>
    </section>
    <script>
      import { startMotion } from '../scripts/motion';
      startMotion();
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-exp-tabs] [data-kind]')];
      // On a phone the tab bar scrolls sideways; its right edge fades until the last tab is in view.
      const bar = document.querySelector<HTMLElement>('[data-exp-tabs]');
      const edge = () => bar?.classList.toggle('at-end', bar.scrollLeft + bar.clientWidth >= bar.scrollWidth - 4);
      bar?.addEventListener('scroll', edge, { passive: true }); addEventListener('resize', edge); edge();
      const asked = tabs.find((b) => location.hash === '#' + b.dataset.kind);
      tabs.forEach((b) => b.addEventListener('click', () => {
        tabs.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => { g.hidden = b.dataset.kind !== 'all' && g.dataset.group !== b.dataset.kind; g.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('seen')); });
        document.querySelector('.xp-tabs')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }));
      asked?.click();
    </script>
  </>}

  {page === 'links' && <>
    <h1>{labels[lang].links}</h1>
    <ul class="ledger callsigns">
      {links.items.map((link) => (
        <li><a class="entry slim" href={resolveHref(link.href, lang)}>
          <span class="title">{link.label[lang]}</span>
          {link.detail && <span class="meta">{link.detail[lang]}</span>}
          <span class="arrow"><Mark external={link.external} /></span>
        </a></li>
      ))}
      {socials.items.map((social) => <li><a class="entry slim" href={social.href}><span class="title">{social.label}</span><span class="meta">{social.handle}</span><span class="arrow"><Mark external /></span></a></li>)}
    </ul>
  </>}

  {page === 'galaxy' && <>
    <section class="band galaxy-page bleed ink">
      <p class="kicker">{t.galaxy.eyebrow}</p>
      <h1>{galaxy.title[lang]}</h1>
      <div class="galaxy-grid">
        <div>
          <p class="lede">{galaxy.pitch[lang]}</p>
          <p class="calls"><a class="btn-a" href={galaxyHref(lang)}>{t.galaxy.open}<span class="arrow" aria-hidden="true">↗</span></a>{galaxy.source && <a class="btn-b" href={galaxy.source.href}>{galaxy.source.label[lang]}</a>}</p>
        </div>
        {image ? <img class="shot-big" src={image.src} alt={image.alt[lang]} width="1280" height="800" /> : <div class="orbit" aria-hidden="true"><i></i><b></b></div>}
      </div>
      <h2 class="label">{t.galaxy.facts}</h2>
      <dl class="record">{record.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl>
    </section>
  </>}
</Layout>
