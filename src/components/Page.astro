            <div class="col out"><p>{s2.bots.sheet}</p>{[0, 1, 2, 3].map((k) => <span style={`--k:${k}`}><i></i><em>✓</em></span>)}</div>
          </div>
          <figcaption>{s2.demos.bots}</figcaption>
        </figure>
        <figure data-glow class="demo d-ai" id="demo-ai" data-demo>
          <div class="art" aria-hidden="true">
            <p class="who"><span class="av"></span>{s2.chat.name}<i class="on"></i></p>
            <p class="q">{s2.chat.q}</p>
            <p class="typing"><i></i><i></i><i></i></p>
            <p class="a"><span>{s2.chat.a}</span></p>
          </div>
          <figcaption>{s2.demos.ai}</figcaption>
        </figure>
        <figure data-glow class="demo d-game" id="demo-game" data-demo data-game>
          <div class="art">
            <span class="sun" aria-hidden="true"></span><span class="hills" aria-hidden="true"></span><span class="hills b" aria-hidden="true"></span>
            <span class="ground" aria-hidden="true"></span><span class="hero-sq" aria-hidden="true"><i></i></span><span class="block" aria-hidden="true"></span><span class="coin" aria-hidden="true"></span>
            <p class="hud" aria-hidden="true">{s2.score} <b data-score>0</b></p>
            <button type="button" class="try">{s2.tryIt}</button>
          </div>
          <figcaption>{s2.demos.game}</figcaption>
        </figure>
        <figure data-glow class="demo d-design" id="demo-design" data-demo data-design>
          <div class="art" aria-hidden="true">
            <p class="tools"><i></i><i></i><i></i><i></i></p>
            <div class="canvas"><div class="poster"><span class="sun"></span><span class="band1"></span><span class="band2"></span><b>Aa</b></div><span class="sel"></span></div>
            <p class="swatches"><i></i><i></i><i></i><i></i></p>
          </div>
          <figcaption>{s2.demos.design}</figcaption>
        </figure>
        <figure data-glow class="demo d-video" id="demo-video" data-demo>
          <div class="art" aria-hidden="true">
            <div class="viewer"><span class="scene"><i class="sun"></i><i class="hill"></i></span><p class="rec">REC</p><p class="tc">00:00:<b>12</b></p></div>
            <div class="tracks"><p class="trk v"><span class="c1"></span><span class="c2"></span><span class="c3"></span></p><p class="trk a">{Array.from({ length: 36 }, (_, k) => <i style={`--h:${20 + ((k * 37) % 70)}%`}></i>)}</p><i class="head"></i></div>
          </div>
          <figcaption>{s2.demos.video}</figcaption>
        </figure>
        <figure data-glow class="demo d-model" id="demo-model" data-demo data-model>
          <div class="art" aria-hidden="true">
            <span class="floor"></span>
            <div class="cube">{['f', 'b', 'l', 'r', 't', 'd'].map((f) => <span class={'face ' + f}></span>)}</div>
            <p class="gizmo"><i class="x">X</i><i class="y">Y</i><i class="z">Z</i></p>
          </div>
          <figcaption>{s2.demos.model}</figcaption>
        </figure>
      </div>
    </section>

    <section class="band ideas bleed warm" aria-labelledby="ideas-title">
      <h2 id="ideas-title" data-reveal>{s2.ideasTitle[0]}<em>{s2.ideasTitle[1]}</em></h2>
      <div class="marquee" aria-label={s2.ideas.join(', ')}>
        {[0, 1].map((row) => (
          <div class={'track' + (row ? ' back' : '')} aria-hidden="true">
            {[0, 1].map(() => <span class="run">{(row ? [...s2.ideas].reverse() : s2.ideas).map((e) => <span class="ev">{e}</span>)}</span>)}
          </div>
        ))}
      </div>
    </section>

    <section class="band svc-end bleed ink deep" aria-labelledby="end-title">
      <h2 id="end-title" data-reveal>{s2.endTitle[0]}<em>{s2.endTitle[1]}</em></h2>
      <p class="lede" data-reveal>{s2.endLead}</p>
      <p class="calls" data-reveal><a class="btn-a big" href={startHref}>{s2.start}<span class="arrow" aria-hidden="true">→</span></a></p>
    </section>
