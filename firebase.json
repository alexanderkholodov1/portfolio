{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/private/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/little-galaxy/admin{,/**}",
        "destination": "/little-galaxy/admin.html"
      },
      {
        "source": "/little-galaxy{,/**}",
        "destination": "/little-galaxy/index.html"
      },
      {
        "source": "**",
        "destination": "/404.html"
      }
    ],
    "headers": [
      {
        "source": "/little-galaxy{,/,/admin,/screen,/timelapse}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/galaxy/screen{,/**}",
        "destination": "/little-galaxy/screen",
        "type": 301
      },
      {
        "source": "/galaxy{,/**}",
        "destination": "/little-galaxy/",
        "type": 301
      }
    ]
  }
}
